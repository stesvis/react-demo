# Step 1: Use the official Node.js image as a build stage
FROM node:18-alpine AS build

ENV NODE_ENV=production

# Step 2: Set the working directory
WORKDIR /app

# Step 3: Copy package.json and package-lock.json
COPY package*.json ./

# Step 4: Add GitHub authentication token

# Step 5: Install dependencies
RUN npm install

# Step 6: Copy the rest of the app's source code
COPY . .

# Step 7: Build the React app
RUN npm run build:staging

# Step 8: Use the latest Nginx Alpine image to serve the app
FROM nginx:1.23-alpine

# Step 9: Copy build files from the previous stage
COPY --from=build /app/build /usr/share/nginx/html

# Step 10: Copy Nginx configuration file
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Step 11: Expose ports 3500 and 3501
EXPOSE 80
EXPOSE 443

# Step 12: Start Nginx server
CMD ["nginx", "-g", "daemon off;"]